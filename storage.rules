rules_version = '2';
// Privatna pohrana audio snimaka: snimci/<id sastanka>/<naziv>.
// Klijent smije samo otpremiti (dok je sastanak u fazi snimanja/obrade). Čitanje i brisanje rade samo funkcije.
service firebase.storage {
  match /b/{bucket}/o {

    function meetingDoc(id) { return firestore.get(/databases/(default)/documents/meetings/$(id)).data; }
    function memDoc() { return firestore.get(/databases/(default)/documents/memberships/$(request.auth.uid)).data; }
    function isDirektor(inst) { return memDoc().get(inst, '') == 'direktor'; }
    function isCreatorOrDirector(m) {
      return m.createdBy == request.auth.uid
        || (m.scope == 'ZAJEDNICKI' ? (isDirektor('IMH') && isDirektor('IDSS')) : isDirektor(m.scope));
    }

    match /snimci/{meetingId}/{file} {
      allow create: if request.auth != null
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*')
        && meetingDoc(meetingId).status in ['snimanje', 'obrada']
        && isCreatorOrDirector(meetingDoc(meetingId));
      allow read, update, delete: if false;
    }
  }
}
